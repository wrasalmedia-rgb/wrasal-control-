{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrasal.local/schema/visual-dna-conformance-v001.json",
  "title": "WRASAL Visual DNA Conformance Manifest v001",
  "type": "object",
  "required": ["artifact_id", "observations", "blind_test", "negative_flags", "cultural_review", "technical_review", "unsupported_decisions"],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "specimen_id": {"type": ["string", "null"]},
    "source_type": {"type": "string"},
    "observations": {"$ref": "#/$defs/claims"},
    "inferred_observations": {"$ref": "#/$defs/claims"},
    "blind_test": {
      "type": "object",
      "required": ["logo", "typography", "metadata", "coordinates", "gold_red_indicators", "evaluator_result", "rationale"],
      "properties": {
        "logo": {"const": true}, "typography": {"const": true}, "metadata": {"const": true}, "coordinates": {"const": true}, "gold_red_indicators": {"const": true},
        "evaluator_result": {"enum": ["pass", "fail", "unknown"]}, "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "negative_flags": {"type": "array", "items": {"type": "string"}},
    "cultural_review": {"$ref": "#/$defs/review"},
    "technical_review": {"$ref": "#/$defs/review"},
    "unsupported_decisions": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "claim": {"type": "object", "required": ["status", "evidence"], "properties": {"status": {"enum": ["satisfied", "violated", "not_observed"]}, "evidence": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "claims": {"type": "object", "additionalProperties": {"$ref": "#/$defs/claim"}},
    "review": {"type": "object", "required": ["status", "evidence"], "properties": {"status": {"enum": ["pass", "fail", "unknown"]}, "evidence": {"type": "string", "minLength": 1}, "cliche_flags": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
