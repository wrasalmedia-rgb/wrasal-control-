{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrasal.local/schema/visual-production-pilot-v001.json",
  "title": "WRASAL Visual Production Pilot v001 report",
  "type": "object",
  "required": ["schema_version", "pilot_id", "intent_id", "scope", "execution", "evidence_separation", "conformance", "human_review", "override_density", "governance"],
  "properties": {
    "schema_version": {"const": "WRASAL_VISUAL_PRODUCTION_PILOT_v001"},
    "pilot_id": {"const": "WRASAL-0014"},
    "intent_id": {"type": "string"},
    "scope": {"type": "object"},
    "execution": {"type": "object"},
    "evidence_separation": {"type": "object", "required": ["canonical", "execution", "observational"]},
    "conformance": {"type": "object"},
    "human_review": {"type": "object"},
    "override_density": {"type": "object", "required": ["execution_decisions", "human_interventions", "override_density", "interventions"]},
    "governance": {"type": "object", "required": ["no_provider_canon", "artifact_is_not_canon", "manual_overrides_require_reason", "repeated_overrides_are_system_diagnostics", "v002_promotion"]}
  },
  "additionalProperties": true
}
