# WRAYVE server-side configuration. Never commit real values.
# Absent values do NOT degrade into a fake success: real execution is refused
# at the adapter boundary and the missing contract element is reported.

# WRASAL-0013: no surface has been observed from this environment. WRAYVE will
# not choose one on documentation alone. Unset => PROVIDER_SURFACE_UNVERIFIED.
# v1/v2 are documented as sunset 2026-10-31; v3 is the documented replacement.
HEYGEN_API_SURFACE=

HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=   # optional on v3: avatar default voice is used when omitted
HEYGEN_BACKGROUND_COLOR=

PORT=4173
HOST=0.0.0.0
WRAYVE_DATA_DIR=
